# Neon Managed Better Auth — copy from Neon Console → Auth → Auth URL
VITE_NEON_AUTH_URL=https://ep-xxxx.neonauth.region.aws.neon.build/dbname/auth

# Neon Data API — Console → Data API → URL (…/rest/v1)
# Optional: if omitted, the app derives it from VITE_NEON_AUTH_URL
# (neonauth → apirest, /auth → /rest/v1).
VITE_NEON_DATA_API_URL=https://ep-xxxx.apirest.region.aws.neon.build/dbname/rest/v1

# After first signup/login: Neon Console → Auth → Users → Make admin
# (required so /users can create staff accounts with passwords)

# Run db/schema.sql once in Neon Console → SQL Editor before syncing shop data.

# Public site URL for SEO (canonical, Open Graph, sitemap). No trailing slash.
VITE_SITE_URL=https://shoponclick.com
